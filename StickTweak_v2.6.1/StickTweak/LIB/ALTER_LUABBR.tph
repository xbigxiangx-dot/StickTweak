DEFINE_ACTION_FUNCTION ~ALTER_LUABBR~	// 改变 LUABBR.2da特定行
	STR_VAR KIT = ~~	ABBREV = ~~
BEGIN

COPY_EXISTING ~LUABBR.2da~ ~Override~
	COUNT_2DA_COLS cols
	READ_2DA_ENTRIES_NOW rows cols
	FOR (i = 1; i < rows; ++i) BEGIN
		READ_2DA_ENTRY i 0 cols KIT_temp
		PATCH_IF (~%KIT_temp%~ STRING_EQUAL ~%KIT%~) BEGIN
				SET_2DA_ENTRY i 1 cols ~%ABBREV%~
				PRETTY_PRINT_2DA
		END	
	END
END